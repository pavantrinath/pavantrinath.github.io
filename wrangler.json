{
  "name": "pavantrinath",
  "compatibility_date": "2026-10-21",
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "10212601",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
